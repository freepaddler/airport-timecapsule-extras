# Shared definitions and helpers for extras components.
# Sourced by scripts through the fixed path /mnt/Flash/extras/include.
# Sourcing also prepares directories, ensures the leases file exists and loads
# runtime values. These existing initialization actions are retained here.

### Configuration
# Load functional user settings; internal paths and constants are assigned below.
. /mnt/Flash/extras.conf

### Storage paths and shared directories
# Flash: scripts and persistent configuration. HDD: stored binary payload.
# Memory: executable copies, process IDs and shared runtime values.
FLASH_DIR="/mnt/Flash/extras"
MEM_DIR="/mnt/Memory/extras"
HDD_MOUNT="/Volumes/dk2"
HDD_DIR="$HDD_MOUNT/extras"
SH_DIR="$FLASH_DIR/bin"

BIN_DIR="$MEM_DIR/bin"
[ ! -d "$BIN_DIR" ] && mkdir -p "$BIN_DIR"

CONF_DIR="$FLASH_DIR/conf"
[ ! -d "$CONF_DIR" ] && mkdir -p "$CONF_DIR"

RUN_DIR="$MEM_DIR/run"
[ ! -d "$RUN_DIR" ] && mkdir -p "$RUN_DIR"

# Keep the trailing slash: runtime-value helpers concatenate filenames to it.
VAR_DIR="$MEM_DIR/vars/"
[ ! -d "$VAR_DIR" ] && mkdir -p "$VAR_DIR"

### DHCP files shared with DNS
# DHCP uses these files; DNS reads them to build local records.
DHCPD_LEASES="$CONF_DIR/dhcpd.leases"
[ -f "$DHCPD_LEASES" ] || touch "$DHCPD_LEASES"
DHCPD_CONF="$CONF_DIR/dhcpd.conf"

### Logging and rotation paths
DEBUG="${DEBUG:-0}"
# Functional settings may be overridden in extras.conf.
LOG_FILE_SIZE="${LOG_FILE_SIZE:-512}"
LOG_FILE_SIZE_CHECK="${LOG_FILE_SIZE_CHECK:-14400}"
LOG_FILE="/var/log/extras.log"
LOG_FILE_OLD="$LOG_FILE.old"

# name of logging script
EXTRAS_LOG_SCRIPT_NAME=$(basename "$0")

# function to log message to log file
# parameters
#   $1 message to log
log() {
    echo -e "$(date +"%Y.%m.%d %T") [$EXTRAS_LOG_SCRIPT_NAME] $1" >> "$LOG_FILE"
}

# Debug messages use the same log, only when DEBUG=1.
debug() {
    [ "$DEBUG" = "1" ] && log "$1"
}

### Shared runtime values
# Exchanged between interface handlers and component scripts through VAR_DIR.
# Load shared runtime values: each filename is a variable name.
read_vars() {
    for f in $VAR_DIR*; do
        [ -e "$f" ] && eval "${f#$VAR_DIR}=\$(cat \"\$f\")"
    done
}

# Clear values managed through VAR_DIR and remove their files.
flush_vars() {
    # unassign existing vars
    for f in in $VAR_DIR*; do
        eval ${f#$VAR_DIR}=
    done
    # delete var files
    rm -f $VAR_DIR*
    read_vars
}

# Store a runtime value and reload the shared values.
# $1: variable name; $2: value.
set_var() {
    printf '%s\n' "$2" > "$VAR_DIR$1"
    read_vars
}

# Remove a stored runtime value and reload the remaining values.
# $1: variable name.
del_var() {
    rm -f "$VAR_DIR$1"
    read_vars
}

### Network address helpers
# Check dotted IPv4 syntax; octet ranges are not validated.
# parameters
#   $1 ip address
isIPv4() {
    if [ x"$1" = x"$(echo $1 | sed -rn 's/^(([0-9]{1,3}\.){3}[0-9]{1,3})$/\1/p')" ]; then
        return 0
    else
        return 1
    fi
}

# Filter unusable addresses in external-interface event handlers.
# This excludes 0.0.0.0 and 169.*, not all private IPv4 ranges.
# parameters
#   $1 ip address
isPubIP() {
    case $1 in
        0.0.0.0 | 169.*)
            return 1
            ;;
        *)
            return 0
            ;;
    esac
}

### File metadata helpers
# get file modification time
# parameters
#   $1 full file path
getModTime() {
    if [ -e "$1" ]; then
        ls -lT "$1" | (
            read a a a a a t1 t2 t3 t4 a
            local t="$t1 $t2 $t3 $t4"
            echo $(date -d "$t" "+%s")
        )
    else
        echo 0
    fi
}

### Raw ACP property helpers
# Split a raw ACP key=value line; remove surrounding value quotes.
acpGetKey() {
    echo "${1%%=*}"
}
acpGetValue() {
    local v="${1#*=}"
    v="${v#\"}"
    v="${v%\"}"
    echo "$v"
}

### ACP MaSt volume discovery
# $1: partition device name, e.g. dk2.
# Output: disk:partition:users, e.g. wd0:dk2:1.
# users is the diskd volume-use count, not a list of SMB accounts.
getVolume() {
    local partition="$1"
    local MaSt line value
    local depth=0
    local disk="" volume="" users=""

    MaSt=$(/usr/bin/acp -A MaSt) || return 1

    # MaSt objects: level 1 is a disk, level 2 is a partition.
    printf '%s\n' "$MaSt" | while read -r line; do
        case "$line" in
            "{")
                depth=$((depth + 1))
                case "$depth" in
                    1) disk="" ;;
                    2) volume=""; users="" ;;
                esac
                ;;
            "}")
                if [ "$depth" -eq 2 ] &&
                   [ "$volume" = "$partition" ] &&
                   [ -n "$disk" ]; then
                    case "$users" in
                        ""|*[!0-9]*) return 1 ;;
                    esac

                    printf '%s:%s:%s\n' "$disk" "$volume" "$users"
                    return 0
                fi
                depth=$((depth - 1))
                ;;
            deviceName=*)
                value="${line#*=}"
                value="${value#\"}"
                value="${value%\"}"

                case "$depth" in
                    1) disk="$value" ;;
                    2) volume="$value" ;;
                esac
                ;;
            users=*)
                if [ "$depth" -eq 2 ]; then
                    users="${line#*=}"
                fi
                ;;
        esac
    done
}

### Volume mount checks and waiting
# DISKS lists partition devices watched by disk-watchd.sh. Timeouts are seconds.
DISKS="dk2"
DISK_IDLE_TIMEOUT="300"
DISK_CHECK_TIMEOUT="15"

# $1: exact mount point, without a trailing slash (except /).
# A directory inside a mounted filesystem does not count as a mount point.
volumeIsMounted() {
    local path="$1"
    set -- $(df -P "$path" 2> /dev/null | tail -1)
    [ "$6" = "$path" ]
}

# $1: exact mount point. Consumers check their own files after this wait.
# Mounting itself is handled by disk-watchd.sh, not by this function.
waitMount() {
    while :; do
        if volumeIsMounted "$1"; then
            return 0
        fi
        log "waiting volume $1 to be mounted..."
        sleep "$DISK_CHECK_TIMEOUT"
    done
}


### Initial runtime-state load
# Preserve automatic loading for every script that sources this file.
read_vars
