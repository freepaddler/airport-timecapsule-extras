### Variables management
# include config variables
. /mnt/Flash/extras.conf

DEBUG="${DEBUG:-0}"

FLASHDIR="${FLASHDIR:-/mnt/Flash/extras}"
MEMDIR="${MEMDIR:-/mnt/Memory/extras}"
LOGFILE="${LOGFILE:-/var/log/extras.log}"
LOGYESTERDAY="${LOGYESTERDAY:-/var/log/extras.yesterday}"
SHDIR="$FLASHDIR/bin"

DISKS="${DISKS:-dk2}"
DISK_IDLE_TIMEOUT="${DISK_IDLE_TIMEOUT:-300}"
DISK_CHECK_TIMEOUT="${DISK_CHECK_TIMEOUT:-15}"

HDDDIR="${HDDDIR:-/Volumes/dk2/ShareRoot/extras}"

BINDIR="$MEMDIR/bin"
[ ! -d "$BINDIR" ] && mkdir -p "$BINDIR"

CONFDIR="$FLASHDIR/conf"
[ ! -d "$CONFDIR" ] && mkdir -p "$CONFDIR"

# set run directory
RUNDIR="$MEMDIR/run"
[ ! -d "$RUNDIR" ] && mkdir -p "$RUNDIR"

# set vars directory
VARDIR="$MEMDIR/vars/"
[ ! -d "$VARDIR" ] && mkdir -p "$VARDIR"

DHCPD_LEASES="$CONFDIR/dhcpd.leases"
[ -f "$DHCPD_LEASES" ] || touch "$DHCPD_LEASES"
DHCPD_CONF="$CONFDIR/dhcpd.conf"

# read and assign variables from files
read_vars() {
    for f in $VARDIR*; do
        [ -e "$f" ] && eval ${f#$VARDIR}="$(cat $f)"
    done
}

# remove all variables
flush_vars() {
    # unassign existing vars
    for f in in $VARDIR*; do
        eval ${f#$VARDIR}=
    done
    # delete var files
    rm -f $VARDIR*
    read_vars
}

# set variable
set_var() {
    echo "$2" > "$VARDIR$1"
    read_vars
}

# delete variable
del_var() {
    rm -f "$VARDIR$1"
    read_vars
}

### logging settings
# name of logging script
name=$(basename "$0")

# function to log message to log file
# parameters
#   $1 message to log
lg() {
    echo -e "$(date +"%Y.%m.%d %T") [$name] $1" >> "$LOGFILE"
}

dbg() {
    [ "$DEBUG" = "1" ] && lg "$1"
}

### common functions

# check if ip address is IPv4
# parameters
#   $1 ip address
isIPv4() {
    if [ x"$1" = x"$(echo $1 | sed -rn 's/^(([0-9]{1,3}\.){3}[0-9]{1,3})$/\1/p')" ]; then
        return 0
    else
        return 1
    fi
}

# check if ip address is public
# to run on external interface
# parameters
#   $1 ip address
isPubIP() {
    case $1 in
        0.0.0.0 | 169.*)
            return 1
            ;;
        *)
            return 0
            ;;
    esac
}

# get file modification time
# parameters
#   $1 full file path
getModTime() {
    if [ -e "$1" ]; then
        ls -lT "$1" | (
            read a a a a a t1 t2 t3 t4 a
            local t="$t1 $t2 $t3 $t4"
            echo $(date -d "$t" "+%s")
        )
    else
        echo 0
    fi
}
## parce ACP properties

STATE_START=-1
STATE_END=0
STATE_DISKS=1
STATE_DISK=2
STATE_USERS=2
STATE_USER=1
STATE_PARTITIONS=3
STATE_PARTITION=4

acpGetKey() {
    echo "${1%%=*}"
}
acpGetValue() {
    local v="${1#*=}"
    v="${v#\"}"
    v="${v%\"}"
    echo "$v"
}

# hdd structure disk:partition:users
hddNew() {
    echo "::"
}
hddGetDisk() {
    echo "${1%%:*}"
}
hddGetPartition() {
    local v="${1#*:}"
    echo "${v%%:*}"
}
hddGetUsers() {
    echo "${1##*:}"
}
hddSetDisk() {
    partition=$(hddGetPartition "$1")
    users=$(hddGetUsers "$1")
    printf "%s:%s:%s" "$2" "$partition" "$users"
}
hddSetPartition() {
    disk=$(hddGetDisk "$1")
    users=$(hddGetUsers "$1")
    printf "%s:%s:%s" "$disk" "$2" "$users"
}
hddSetUsers() {
    disk=$(hddGetDisk "$1")
    partition=$(hddGetPartition "$1")
    printf "%s:%s:%s" "$disk" "$partition" "$2"
}

getVolume() {
    local partition=$1
    local MaSt
    local hdd
    local state
    local key
    local value
    local lastKey
    local error

    MaSt=$(/usr/bin/acp -A MaSt)
    state=$STATE_START
    echo "$MaSt" | while read -r line; do
        error=""
        key=$(acpGetKey "$line")
        value=$(acpGetValue "$line")
        case $line in
            [)
                case $state in
                    "$STATE_START")
                        state=$STATE_DISKS
                        ;;
                    "$STATE_DISK")
                        if [ "$lastKey" = "partitions" ]; then
                            state=$STATE_PARTITIONS
                        else
                            lg "invalid '[' in state disk"
                        fi
                        ;;
                    *)
                        error="parse error on '['"
                        ;;
                esac
                ;;
            "{")
                case $state in
                    "$STATE_DISKS")
                        state=$STATE_DISK
                        hdd=$(hddNew)
                        ;;
                    "$STATE_PARTITIONS")
                        state=$STATE_PARTITION
                        ;;
                    *)
                        error="parse error on '}'"
                        ;;
                esac
                ;;
            ])
                case $state in
                    "$STATE_DISKS")
                        state=$STATE_END
                        ;;
                    "$STATE_PARTITIONS")
                        state=$STATE_DISK
                        ;;
                    *)
                        error="parse error on ']'"
                        ;;
                esac
                ;;
            "}")
                case $state in
                    "$STATE_DISK")
                        state=$STATE_DISKS
                        ;;
                    "$STATE_PARTITION")
                        state=$STATE_PARTITIONS
                        ;;
                    *)
                        error="parse error on '}'"
                        ;;
                esac
                ;;
            users=*)
                if [ "$state" = "$STATE_PARTITION" ] && [ -n "$(hddGetPartition "$hdd")" ]; then
                    hdd=$(hddSetUsers "$hdd" "$value")
                fi
                ;;
            deviceName=*)
                case $state in
                    "$STATE_DISK")
                        hdd=$(hddSetDisk "$hdd" "$value")
                        ;;
                    "$STATE_PARTITION")
                        if [ "$partition" = "$value" ]; then
                            hdd=$(hddSetPartition "$hdd" "$value")
                        fi
                        ;;
                    *)
                        error="parse error on 'deviceName'"
                        ;;
                esac
                ;;
        esac
        if [ -n "$error" ]; then
            lg "ERROR: MaSt parse: $(printf "state: %s, key: %s, value: %s, lastKey: %s, error: %s\n" "$state" "$key" "$value" "$lastKey" "$error")"
            return
        fi
        lastKey="$key"
        if [ -n "$(hddGetUsers "$hdd")" ]; then
            echo "$hdd"
            return
        fi
        if [ "$state" = "$STATE_END" ]; then
            return
        fi
    done
}

getVolumePath() {
    local v="${1#/Volumes/}"
    v="${v%%/*}"
    printf "/Volumes/%s\n" "$v"
}

volumeIsMounted() {
    path=$(getVolumePath "$1")
    set -- $(df -P "$path" 2> /dev/null | tail -1)
    [ "$6" = "$path" ]
}

waitMount() {
    while :; do
        if volumeIsMounted "$1"; then
            ls "$1" > /dev/null
            return
        fi
        lg "waiting volume $1 to be mounted..."
        sleep "$DISK_CHECK_TIMEOUT"
    done
}

read_vars
